{
  "name": "@each1024/pi-jev-route",
  "version": "1.0.3",
  "description": "Automatic Jev model selection at Pi subagent dispatch, with scoped model descriptions and a local HTML audit console.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eachann1024/pi-jev-route.git"
  },
  "homepage": "https://github.com/eachann1024/pi-jev-route",
  "bugs": {
    "url": "https://github.com/eachann1024/pi-jev-route/issues"
  },
  "type": "module",
  "license": "MIT",
  "author": "eachann1024",
  "keywords": [
    "pi-package",
    "pi-extension",
    "jev",
    "subagents",
    "model-routing"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "video": "https://raw.githubusercontent.com/eachann1024/pi-jev-route/main/docs/media/pi-jev-route-guide-en.mp4"
  },
  "files": [
    "index.ts",
    "lib",
    "web",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "docs/reference.md",
    "docs/reference.zh-CN.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node test/core.mjs && node test/audit.mjs && node test/observability.mjs && node test/integration.mjs && node test/onboarding.mjs && node test/supervision-policy.mjs && node test/supervision-runtime.mjs && node test/supervision-settings.mjs",
    "prepublishOnly": "npm run check && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.85.1",
    "@earendil-works/pi-coding-agent": ">=0.85.1",
    "@earendil-works/pi-tui": ">=0.85.1"
  },
  "dependencies": {
    "minimatch": "10.2.5"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^26.4.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
